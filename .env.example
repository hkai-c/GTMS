# GTMS 环境变量配置示例
# 复制此文件为 .env 并修改为实际配置
# WARNING: .env 文件包含敏感信息，不要提交到 Git

# ============================================================
# 运行环境
# ============================================================

# 环境模式: development / production
ENV_MODE=development

# 调试模式 (生产环境请设为 false)
DEBUG=true

# ============================================================
# 数据库配置
# ============================================================

# 开发环境 (SQLite)
DATABASE_URL=sqlite:///./database/gtms.db

# 生产环境 (MySQL) — 上线时切换
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/gtms

# ============================================================
# 安全配置
# ============================================================

# JWT 密钥 (生产环境请更换为随机字符串)
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# JWT 算法
ALGORITHM=HS256

# Token 过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================
# 文件上传配置
# ============================================================

# 上传根目录
UPLOAD_DIR=./uploads

# 图片最大大小 (MB)
MAX_IMAGE_SIZE_MB=10

# 文档最大大小 (MB)
MAX_DOCUMENT_SIZE_MB=50

# CAD 文件最大大小 (MB)
MAX_CAD_SIZE_MB=50

# 视频最大大小 (MB)
MAX_VIDEO_SIZE_MB=200

# 允许的图片格式
ALLOWED_IMAGE_TYPES=jpg,jpeg,png

# 允许的文档格式
ALLOWED_DOCUMENT_TYPES=pdf,docx,xlsx

# 允许的 CAD 格式
ALLOWED_CAD_TYPES=dwg,dxf

# 允许的视频格式
ALLOWED_VIDEO_TYPES=mp4

# ============================================================
# 服务配置
# ============================================================

# 服务监听地址
SERVER_HOST=0.0.0.0

# 服务监听端口
SERVER_PORT=8000

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# 日志文件目录
LOG_DIR=./logs

# ============================================================
# 备份配置
# ============================================================

# 备份目录
BACKUP_DIR=./backup

# 备份时间 (cron 格式: 分 时)
BACKUP_CRON_HOUR=2
BACKUP_CRON_MINUTE=0

# ============================================================
# 消息提醒配置
# ============================================================

# 收件超时提醒 (小时)
NOTIFY_RECEIPT_DELAY_HOURS=48

# 试磨超时提醒 (小时)
NOTIFY_GRINDING_DELAY_HOURS=120

# 报告缺失提醒 (小时)
NOTIFY_REPORT_MISSING_HOURS=72

# 定时检查间隔 (分钟)
NOTIFY_CHECK_INTERVAL_MINUTES=60

# ============================================================
# 桌面客户端配置
# ============================================================

# API 基础地址
API_BASE_URL=http://localhost:8000/api

# 列表每页条数
PAGE_SIZE=20